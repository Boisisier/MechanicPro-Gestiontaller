NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://usuario:clave@host:5432/base
DATABASE_SSL=require
DATABASE_SSL_REJECT_UNAUTHORIZED=false
JWT_SECRET=reemplazar-por-un-secreto-de-al-menos-32-caracteres
CORS_ORIGINS=http://localhost:5173
# El login demo (email/clave fijos definidos abajo) se desactiva automáticamente en
# producción. Solo poner en "true" si de verdad necesitas exponerlo en producción.
ALLOW_DEMO_LOGIN=false
TRUST_PROXY=false
JSON_BODY_LIMIT=1mb
VITE_API_BASE_URL=http://localhost:3001
