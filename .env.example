NODE_ENV=development
PORT=3001
# Debe conectar con un rol de base de datos SIN el atributo BYPASSRLS (en Supabase, el rol
# "postgres" tiene BYPASSRLS y por lo tanto ignora las políticas de Row Level Security). Usar
# el rol "app_runtime" creado por supabase/migrations/20260707020000_create_app_runtime_role.sql
# (en el pooler de Supabase el usuario va como "app_runtime.<project-ref>").
DATABASE_URL=postgresql://app_runtime.<project-ref>:clave@host:5432/base
DATABASE_SSL=require
DATABASE_SSL_REJECT_UNAUTHORIZED=false
JWT_SECRET=reemplazar-por-un-secreto-de-al-menos-32-caracteres
CORS_ORIGINS=http://localhost:5173
# El login demo (email/clave fijos definidos abajo) se desactiva automáticamente en
# producción. Solo poner en "true" si de verdad necesitas exponerlo en producción.
ALLOW_DEMO_LOGIN=false
TRUST_PROXY=false
JSON_BODY_LIMIT=1mb
VITE_API_BASE_URL=http://localhost:3001
# Dónde vive el frontend, visto desde afuera. El servidor la necesita para armar el link del
# portal de clientes (`${PUBLIC_WEB_URL}/estado/<token>`) cuando se lo reenvía a alguien que lo
# perdió. En producción frontend y API son servicios distintos, con dominios distintos (ver
# render.yaml), así que el servidor no puede deducirla. Si falta, /public/recover-access
# responde igual (nunca revela si hubo coincidencia) pero no envía nada, y queda logueado.
PUBLIC_WEB_URL=http://localhost:5173
# WhatsApp Cloud API (Meta), para enviarle al cliente del taller el link de seguimiento.
# Todo opcional: sin WHATSAPP_PHONE_NUMBER_ID + WHATSAPP_ACCESS_TOKEN el envío queda en modo
# simulado (solo loguea que se habría enviado, y en desarrollo imprime el link en consola), así
# que el flujo completo se puede probar sin credenciales. Ver docs/produccion.md para cómo dar
# de alta el número y la plantilla en Meta.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECOVERY_TEMPLATE=recuperar_link_seguimiento
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_API_VERSION=v21.0
